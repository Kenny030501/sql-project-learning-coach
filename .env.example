# Copy to .env locally or set COACH_ENV_FILE to your existing configuration path.
# Never paste keys into chat or commit them.
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
XAI_API_KEY=
TEXT_PROVIDER=deepseek
TEXT_MODEL=
# Provider pricing must be checked before enabling paid calls.
# Conservative reservations use these upper-bound tariffs, USD per million tokens.
INPUT_USD_PER_M=10
OUTPUT_USD_PER_M=30
PAID_CALLS_ENABLED=false
# Both products share this ledger; don't change it independently.
# Leave blank to share ../.ai-coach-state/budget.sqlite with sibling coach projects.
# If the projects are not siblings, set the SAME explicit path in both.
COACH_BUDGET_DB=
